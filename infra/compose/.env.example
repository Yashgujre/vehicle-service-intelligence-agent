# Copy to infra/compose/.env on the VM (scripts/deploy_vm.sh does this from your local copy).
# Never commit the filled-in file. Generate secrets with: openssl rand -hex 32

# --- Host names (Caddy issues TLS certificates for these). Without DNS, use sslip.io:
#     chat.<ip-with-dashes>.sslip.io resolves to that IP.
CHAT_FQDN=chat.203-0-113-10.sslip.io
N8N_FQDN=n8n.203-0-113-10.sslip.io
API_FQDN=api.203-0-113-10.sslip.io
ACME_EMAIL=you@your-domain.dev
TZ=America/Chicago

# --- Postgres (passwords are applied by postgres-init.sql on the first start of an empty volume only)
POSTGRES_PASSWORD=change-me-postgres
VSIA_DB_PASSWORD=change-me-vsia
N8N_DB_PASSWORD=change-me-n8n
MLFLOW_DB_PASSWORD=change-me-mlflow

# --- n8n. N8N_ENCRYPTION_KEY must stay stable forever, or saved credentials become unreadable.
N8N_ENCRYPTION_KEY=change-me-32-plus-random-characters-000000
N8N_PROTOCOL=https
VSIA_REVIEW_BACKLOG_THRESHOLD=25
# Optional incoming-webhook URL (Slack, Teams, Discord style {"text": ...}) used by the disabled
# notification nodes; leave empty until you enable them.
VSIA_NOTIFY_WEBHOOK_URL=

# --- VSIA API. The bearer token protects every endpoint except /health.
VSIA_API_TOKEN=change-me-api-token
VSIA_LLM_PROVIDER=anthropic
# VSIA_LLM_MODEL=claude-haiku-5-5
VSIA_VECTOR_STORE=pinecone
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=vsia
LLAMA_CLOUD_API_KEY=
# Ollama is not run on the VM (12 GB budget). Point at a reachable server only if you have one.
OLLAMA_BASE_URL=
# Used by the n8n-native triage workflow to route low-confidence outputs to review.
VSIA_CONFIDENCE_THRESHOLD=0.70

# --- Open WebUI
WEBUI_SECRET_KEY=change-me-webui-secret
