# Copy to .env and fill in what you have. Everything runs with no keys at all
# (Ollama + local vector store); keys switch on the hosted services.

# Storage: SQLite by default; Postgres on the VM (Docker Compose sets this).
# DATABASE_URL=postgresql+psycopg://vsia:change-me@localhost:5432/vsia

# LLM provider: ollama | anthropic | openai   (model ids live in config/settings.yaml)
VSIA_LLM_PROVIDER=ollama
# VSIA_LLM_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Retrieval: local | pinecone
VSIA_VECTOR_STORE=local
PINECONE_API_KEY=
PINECONE_INDEX=vsia

# Document parsing: LlamaParse is used when this is set, otherwise the local PDF parser.
LLAMA_CLOUD_API_KEY=

# Human-review routing threshold override (default in config/settings.yaml)
# VSIA_CONFIDENCE_THRESHOLD=0.70

# MLflow (SQLite backend enables the model registry)
# MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
