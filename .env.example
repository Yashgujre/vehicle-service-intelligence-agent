# Copy to .env and fill in what you have. Everything runs with no keys at all
# (Ollama + local vector store); keys switch on the hosted services.

# Storage: SQLite by default; Postgres on the VM (Docker Compose sets this).
# DATABASE_URL=postgresql+psycopg://vsia:change-me@localhost:5432/vsia

# LLM provider: ollama | gemini | groq | anthropic | openai | heuristic (model ids in config/settings.yaml)
VSIA_LLM_PROVIDER=ollama
# VSIA_LLM_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434
# Free tiers, no card (ADR-0088): https://aistudio.google.com/apikey and https://console.groq.com/keys
# Create the Gemini key in a Google project with no billing account so it stays on the free tier.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Retrieval: local | pinecone. Query embeddings: ollama (default) | fastembed (in-process, ADR-0090)
VSIA_VECTOR_STORE=local
# VSIA_EMBED_PROVIDER=fastembed

# Hosted demo only (ADR-0089, ADR-0091, ADR-0092): data bundle to download on first start, and the daily
# cap on calls made with the host's free key.
# VSIA_BUNDLE_URL=https://github.com/<owner>/vehicle-service-intelligence-agent/releases/download/demo-data-v1/vsia-demo-bundle.tar.gz
# VSIA_BUNDLE_SHA256=
# VSIA_HOSTED_DAILY_LLM_CALLS=400
PINECONE_API_KEY=
PINECONE_INDEX=vsia

# Document parsing: LlamaParse is used when this is set, otherwise the local PDF parser.
LLAMA_CLOUD_API_KEY=

# Human-review routing threshold override (default in config/settings.yaml)
# VSIA_CONFIDENCE_THRESHOLD=0.70

# MLflow (SQLite backend enables the model registry)
# MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
